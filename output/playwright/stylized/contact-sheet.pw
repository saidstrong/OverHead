async(page)=>{const results=[];await page.setViewportSize({width:1800,height:1000});for(const name of ['contact-sheet','comparison']){await page.goto(`file:///C:/Users/amanz/Documents/ChatGPT/SMEs/output/playwright/stylized/${name}.html`);await page.evaluate(()=>Promise.all([...document.images].map(i=>i.decode())));await page.screenshot({path:`output/playwright/stylized/${name}.png`,fullPage:true});results.push({name,images:await page.locator('img').count()});}return results;}
