async(page)=>{
 const errors=[];page.on('pageerror',e=>errors.push(e.message));
 await page.emulateMedia({reducedMotion:'no-preference'});await page.setViewportSize({width:375,height:667});await page.goto('http://localhost:3000');
 const scene=page.locator('[data-bar-experience]');await scene.evaluate(el=>scrollTo({top:el.getBoundingClientRect().top+scrollY-24,behavior:'instant'}));
 await page.locator('[data-scene-ready="true"]').waitFor({state:'attached'});await page.evaluate(()=>document.fonts.ready);await page.evaluate(()=>window.dispatchEvent(new Event('resize')));await page.waitForTimeout(1000);
 await scene.evaluate(el=>scrollTo({top:el.getBoundingClientRect().top+scrollY-24+(el.offsetHeight-el.firstElementChild.offsetHeight)*8.7/16,behavior:'instant'}));
 await page.waitForFunction(()=>Math.abs(Number(document.querySelector('[data-bar-experience]').dataset.sceneTime)-8.7)<.025);await page.waitForTimeout(200);
 await page.screenshot({path:'output/playwright/stylized/375-short.png'});
 return {time:await scene.getAttribute('data-scene-time'),overflow:await page.evaluate(()=>document.documentElement.scrollWidth>innerWidth),overlay:await page.locator('vite-error-overlay,[data-nextjs-dialog]').count(),errors};
}
