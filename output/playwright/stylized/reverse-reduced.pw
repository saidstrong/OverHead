async(page)=>{
 const states=[],errors=[],reduced=[];page.on('pageerror',e=>errors.push(e.message));
 for(const width of [1440,375,390,430]){
  await page.emulateMedia({reducedMotion:'no-preference'});await page.setViewportSize({width,height:width===1440?1000:844});await page.goto('http://localhost:3000');
  const scene=page.locator('[data-bar-experience]');await scene.evaluate(el=>scrollTo({top:el.getBoundingClientRect().top+scrollY-24,behavior:'instant'}));await page.locator('[data-scene-ready="true"]').waitFor({state:'attached'});await page.evaluate(()=>document.fonts.ready);await page.evaluate(()=>window.dispatchEvent(new Event('resize')));await page.waitForTimeout(700);
  const at=async(t)=>{await scene.evaluate((el,t)=>scrollTo({top:el.getBoundingClientRect().top+scrollY-24+(el.offsetHeight-el.firstElementChild.offsetHeight)*t/16,behavior:'instant'}),t);await page.waitForFunction(t=>Math.abs(Number(document.querySelector('[data-bar-experience]').dataset.sceneTime)-t)<.025,t,{timeout:10000});};
  for(const t of [16,12.3,8.7,6.1,3,0]){await at(t);states.push({width,target:t,actual:await scene.getAttribute('data-scene-time')});}
  await page.emulateMedia({reducedMotion:'reduce'});await page.waitForTimeout(700);await scene.scrollIntoViewIfNeeded();await page.waitForTimeout(600);await page.locator('.bar-experience').screenshot({path:`output/playwright/stylized/reduced-${width}.png`});
  reduced.push({width,...await scene.evaluate(el=>({time:el.dataset.sceneTime,reduced:el.dataset.reducedMotion,height:el.offsetHeight,panel:el.firstElementChild.offsetHeight,overflow:document.documentElement.scrollWidth>innerWidth}))});
 }
 await page.emulateMedia({reducedMotion:'no-preference'});return {states,reduced,errors};
}
