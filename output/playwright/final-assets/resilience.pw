async(page)=>{
 await page.unrouteAll({behavior:'ignoreErrors'});await page.setViewportSize({width:390,height:844});await page.goto('http://localhost:3000');await page.evaluate(()=>document.fonts.ready);await page.waitForTimeout(700);await page.locator('[data-bar-experience]').evaluate(el=>el.scrollIntoView({block:'start',behavior:'instant'}));await page.locator('[data-scene-ready="true"]').waitFor({state:'attached'});
 const resize=[];for(const width of [610,590,610,375]){await page.setViewportSize({width,height:844});await page.waitForTimeout(350);resize.push(await page.evaluate(()=>({width:innerWidth,failed:document.querySelector('[data-bar-experience]').dataset.sceneFailed,sources:[...document.querySelectorAll('.hybrid-plate picture img')].map(i=>i.currentSrc)})));}
 const alpha=await page.evaluate(()=>[...document.querySelectorAll('.hybrid-plate picture img')].map(i=>{const c=document.createElement('canvas');c.width=i.naturalWidth;c.height=i.naturalHeight;const ctx=c.getContext('2d',{willReadFrequently:true});ctx.drawImage(i,0,0);return {source:i.currentSrc,width:c.width,height:c.height,cornerAlpha:ctx.getImageData(0,0,1,1).data[3]};}));
 await page.route('**/overhead-cocktail-served-mobile.webp',route=>route.abort());await page.goto('http://localhost:3000');await page.evaluate(()=>document.fonts.ready);await page.waitForTimeout(700);await page.locator('[data-bar-experience]').evaluate(el=>el.scrollIntoView({block:'start',behavior:'instant'}));await page.locator('[data-scene-failed="true"]').waitFor({state:'attached'});
 const failure=await page.evaluate(()=>({ready:document.querySelector('[data-bar-experience]').dataset.sceneReady,canvas:!!document.querySelector('[data-bar-experience] canvas'),fallback:!!document.querySelector('.bar-experience__fallback'),overflow:document.documentElement.scrollWidth>innerWidth}));await page.unrouteAll({behavior:'ignoreErrors'});return {resize,alpha,failure};
}
